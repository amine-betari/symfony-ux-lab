{% extends 'base.html.twig' %}

{% block title %}Articles · Symfony UX Lab{% endblock %}

{% block body %}
<main class="container">
    <p class="eyebrow">Chapitre 2 · Twig Components</p>
    <h1>La même interface avec une carte réutilisable</h1>
    <p class="lead">
        Le contrôleur fournit toujours les mêmes données. La boucle reste dans cette page, mais le HTML de chaque carte
        appartient maintenant au composant <code>ArticleCard</code>.
    </p>

    <section class="article-grid" aria-label="Liste des articles">
        {% for article in articles %}
            <twig:ArticleCard :article="article" />
        {% endfor %}
    </section>
</main>
{% endblock %}
