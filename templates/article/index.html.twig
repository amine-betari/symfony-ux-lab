{% extends 'base.html.twig' %}

{% block title %}Articles · Symfony UX Lab{% endblock %}

{% block body %}
<main class="container">
    <p class="eyebrow">Chapitre 4 · Slots et contenu personnalisable</p>
    <h1>Un composant qui accepte du contenu HTML</h1>
    <p class="lead">
        Les props transmettent les données. Le slot <code>actions</code> permet maintenant à la page
        de remplacer une zone HTML précise sans modifier le composant.
    </p>

    <section class="article-grid" aria-label="Liste des articles">
        {% for article in articles %}
            {% if loop.first %}
                <twig:ArticleCard
                    :slug="article.slug"
                    :title="article.title"
                    :excerpt="article.excerpt"
                    :category="article.category"
                    :readingTime="article.readingTime"
                    :icon="article.icon"
                    :accent="article.accent"
                    variant="featured"
                    data-card-index="{{ loop.index }}"
                >
                    <twig:block name="actions">
                        <a class="article-card__link article-card__link--primary" href="{{ path('app_article_show', {slug: article.slug}) }}">
                            Découvrir l’article →
                        </a>
                        <span class="article-card__badge">Choix de la rédaction</span>
                    </twig:block>
                </twig:ArticleCard>
            {% else %}
                <twig:ArticleCard
                    :slug="article.slug"
                    :title="article.title"
                    :excerpt="article.excerpt"
                    :category="article.category"
                    :readingTime="article.readingTime"
                    :icon="article.icon"
                    :accent="article.accent"
                    data-card-index="{{ loop.index }}"
                />
            {% endif %}
        {% endfor %}
    </section>
</main>
{% endblock %}
