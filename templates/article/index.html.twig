{% extends 'base.html.twig' %}

{% block title %}Articles · Symfony UX Lab{% endblock %}

{% block body %}
<main
    class="container"
    data-controller="favorites-counter"
    data-action="favorite:changed->favorites-counter#refresh"
>
    <p class="eyebrow">Chapitre 6 · Communication entre contrôleurs Stimulus</p>
    <h1>Plusieurs favoris et un compteur global</h1>
    <p class="lead">
        Chaque carte gère son état. Un second contrôleur écoute leurs événements et met à jour
        le compteur global, toujours sans recharger la page.
    </p>

    <aside class="favorites-summary" aria-live="polite">
        <div>
            <span class="favorites-summary__icon" aria-hidden="true">★</span>
            <strong>
                <span data-favorites-counter-target="count">0</span>
                <span data-favorites-counter-target="label">article favori</span>
            </strong>
        </div>
        <button
            type="button"
            class="favorites-summary__reset"
            data-favorites-counter-target="reset"
            data-action="favorites-counter#clear"
            hidden
        >
            Tout effacer
        </button>
    </aside>

    <section class="article-grid" aria-label="Liste des articles">
        {% for article in articles %}
            {% if loop.first %}
                <twig:ArticleCard
                    :slug="article.slug"
                    :title="article.title"
                    :excerpt="article.excerpt"
                    :category="article.category"
                    :readingTime="article.readingTime"
                    :icon="article.icon"
                    :accent="article.accent"
                    variant="featured"
                    data-card-index="{{ loop.index }}"
                >
                    <twig:block name="actions">
                        <a class="article-card__link article-card__link--primary" href="{{ path('app_article_show', {slug: article.slug}) }}">
                            Découvrir l’article →
                        </a>
                        <span class="article-card__badge">Choix de la rédaction</span>
                    </twig:block>
                </twig:ArticleCard>
            {% else %}
                <twig:ArticleCard
                    :slug="article.slug"
                    :title="article.title"
                    :excerpt="article.excerpt"
                    :category="article.category"
                    :readingTime="article.readingTime"
                    :icon="article.icon"
                    :accent="article.accent"
                    data-card-index="{{ loop.index }}"
                />
            {% endif %}
        {% endfor %}
    </section>
</main>
{% endblock %}
