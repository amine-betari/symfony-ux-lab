{% extends 'base.html.twig' %}

{% block title %}Articles · Symfony UX Lab{% endblock %}

{% block body %}
<main class="container">
    <p class="eyebrow">Chapitre 3 · Props, attributs et variantes</p>
    <h1>Un composant configurable et mieux typé</h1>
    <p class="lead">
        Chaque information devient une prop typée. La première carte reçoit la variante <code>featured</code>,
        tandis que les attributs HTML supplémentaires sont transmis automatiquement à sa balise racine.
    </p>

    <section class="article-grid" aria-label="Liste des articles">
        {% for article in articles %}
            <twig:ArticleCard
                :slug="article.slug"
                :title="article.title"
                :excerpt="article.excerpt"
                :category="article.category"
                :readingTime="article.readingTime"
                :icon="article.icon"
                :accent="article.accent"
                :variant="loop.first ? 'featured' : 'default'"
                data-card-index="{{ loop.index }}"
            />
        {% endfor %}
    </section>
</main>
{% endblock %}
