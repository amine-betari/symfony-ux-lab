{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} · Symfony UX Lab{% endblock %}

{% block body %}
<main class="container">
    <a class="back-link" href="{{ path('app_articles') }}">← Retour aux articles</a>

    <article class="article-page">
        <p class="eyebrow">{{ article.category }}</p>
        <h1>{{ article.title }}</h1>
        <p class="article-page__meta">Temps de lecture : {{ article.readingTime }} minutes</p>
        <div class="article-page__content">
            <p>{{ article.content }}</p>
        </div>
    </article>
</main>
{% endblock %}
