<article {{ attributes.defaults({
    class: 'article-card article-card--' ~ variant,
    'data-controller': 'favorite',
    'data-favorite-key-value': slug,
    'data-action': 'favorites:cleared@window->favorite#clear'
}) }}>
    <div class="article-card__visual" style="--accent: {{ accent }}">
        {{ icon }}
    </div>
    <div class="article-card__body">
        <span class="article-card__meta">
            {{ category }} · {{ readingTime }} min
        </span>
        <h2>{{ title }}</h2>
        <p>{{ excerpt }}</p>
        <div class="article-card__actions">
            {% block actions %}
                <a class="article-card__link" href="{{ path('app_article_show', {slug}) }}">
                    Lire l’article →
                </a>
            {% endblock %}
            <button
                type="button"
                class="favorite-button"
                aria-pressed="false"
                data-favorite-target="button"
                data-action="favorite#toggle"
            >
                ★ <span data-favorite-target="label">Ajouter aux favoris</span>
            </button>
        </div>
    </div>
</article>
